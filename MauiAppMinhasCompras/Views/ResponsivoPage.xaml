<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ResponsivoPage"
             Title="Tela Responsiva">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Estilo adaptável para labels -->
            <Style TargetType="Label">
                <Setter Property="TextColor" 
                        Value="{AppThemeBinding Light=Black, Dark=White}" />
                <Setter Property="FontSize" Value="Medium" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout x:Name="layoutPrincipal"
                             Spacing="15"
                             Padding="20"
                             VerticalOptions="FillAndExpand"
                             HorizontalOptions="FillAndExpand">

            <Label Text="Cadastro de Produto" 
                   FontSize="Title"
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="15">

                <Label Grid.Row="0" Grid.Column="0" Text="Descrição:" />
                <Entry Grid.Row="0" Grid.Column="1" x:Name="txt_descricao" />

                <Label Grid.Row="1" Grid.Column="0" Text="Quantidade:" />
                <Entry Grid.Row="1" Grid.Column="1" x:Name="txt_quantidade" Keyboard="Numeric" />

                <Label Grid.Row="2" Grid.Column="0" Text="Preço Unitário:" />
                <Entry Grid.Row="2" Grid.Column="1" x:Name="txt_preco" Keyboard="Numeric" />

                <Button Grid.Row="3" Grid.ColumnSpan="2"
                        Text="Salvar"
                        HorizontalOptions="Center"
                        Clicked="OnSalvarClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
